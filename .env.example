# ============================================================
# NEOSEN — Variables d'environnement
# Copiez ce fichier en .env et renseignez vos valeurs.
# Ne versionnez JAMAIS le fichier .env.
# ============================================================

# --- Application ---
# production | development
APP_ENV=production
APP_DEBUG=false
# URL publique (sans slash final). Sous-dossier possible : https://domaine.com/neosensite
APP_URL=https://www.neosen.sn
APP_TIMEZONE=Africa/Dakar
APP_DEFAULT_LANG=fr
# Pour activer l'anglais plus tard : fr,en
APP_LANGS=fr
SESSION_NAME=neosen_sess
# Clé secrète aléatoire (32+ caractères) utilisée pour sécuriser les sessions
APP_KEY=

# --- Base de données MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=neosen
DB_USER=neosen_user
DB_PASS=
DB_CHARSET=utf8mb4

# --- Email (PHPMailer, dossier /utilitaires/PHPMailer) ---
MAIL_HOST=smtp.votre-hebergeur.com
MAIL_PORT=587
# tls | ssl | none
MAIL_ENCRYPTION=tls
MAIL_USERNAME=contact@neosen.sn
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=contact@neosen.sn
MAIL_FROM_NAME=NEOSEN

# --- Google reCAPTCHA (dossier /utilitaires/ReCaptcha) ---
# Laisser vide pour désactiver (le pot de miel et la limitation restent actifs)
# v3 (invisible) | v2 (case à cocher)
RECAPTCHA_VERSION=v3
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# --- Installation (à supprimer après usage) ---
INSTALL_ADMIN_NAME=Administrateur
INSTALL_ADMIN_EMAIL=
INSTALL_ADMIN_PASSWORD=
INSTALL_TOKEN=
